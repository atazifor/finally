# Anthropic API key for AI chat. Without it the app still runs; chat says AI is not configured.
ANTHROPIC_API_KEY=

# Optional: Massive (Polygon.io) API key for real market data. Empty = built-in simulator.
MASSIVE_API_KEY=

# Optional: "true" for deterministic mock LLM responses (testing, no API key needed)
LLM_MOCK=false

# Optional: SQLite file location (default: <project root>/db/finally.db)
DB_PATH=
